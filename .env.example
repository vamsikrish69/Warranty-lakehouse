# Copy to .env for local use, or add each name as a GitHub Codespaces secret.
# NEVER commit real values. .env is listed in .gitignore.

# --- Databricks ---
DATABRICKS_HOST=https://dbc-xxxxxxxx-xxxx.cloud.databricks.com   # scheme + hostname only, no path
DATABRICKS_TOKEN=dapiXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX            # personal access token (expires; rotate)
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxxxxxxxxxx        # SQL warehouse > Connection details

# --- AWS (limited IAM user: one bucket, no delete) ---
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_DEFAULT_REGION=eu-north-1                                    # exact region, no trailing comma or space
S3_BUCKET=your-private-bucket-name

# --- Airflow DAG ---
WARRANTY_JOB_ID=000000000000000                                  # Databricks job id of warranty_dbt_build
BATCHES_PER_RUN=6                                                # 6 x 4h = one simulated day per run
NTFY_TOPIC=choose-a-long-random-topic-name                       # failure alerts; treat like a password
# Optional: repo location if not auto-detected
# WARRANTY_REPO=/path/to/Warranty-lakehouse
